# --- Server ---
PORT=4000
DB_PATH=./data.sqlite

# --- Internal portal integration (open -> internal, one directional) ---
# "pull": the internal portal pulls new applications from this backend
# "push": this backend pushes applications to the internal portal
INTERNAL_ADAPTER_MODE=pull

# Required in PULL mode: protects GET/POST /api/internal/* endpoints.
INTERNAL_API_KEY=CHANGE_ME
# Comma-separated IPs allowed to call /api/internal/*. Leave empty to disable
# the IP check in local development (API key is still required).
INTERNAL_IP_WHITELIST=

# Required in PUSH mode: where/how this backend posts applications to the
# real internal portal. Not provided by the internal portal team yet.
INTERNAL_API_BASE_URL=
INTERNAL_PUSH_API_KEY=
INTERNAL_PUSH_RETRY_MAX=3
INTERNAL_PUSH_RETRY_DELAY_MS=2000
INTERNAL_PUSH_RETRY_INTERVAL_MS=300000


# --- Mock internal portal (dev/test only, see src/adapter/mockInternalPortal.ts) ---
MOCK_INTERNAL_PORT=4100
MOCK_FAIL_RATE=0
MOCK_POLL_INTERVAL_MS=5000
OPEN_BACKEND_URL=http://localhost:4000

# Dinləmə ünvanı. Lokal: 127.0.0.1. Hostinqdə (Render): 0.0.0.0.
HOST=127.0.0.1
# Önündəki etibarlı proksi sayı. Lokal: 0. Render: 1.
TRUST_PROXY=0
# Vergüllə ayrılmış icazəli mənbələr. Frontend eyni domendən verilirsə boş qalır.
CORS_ORIGINS=
